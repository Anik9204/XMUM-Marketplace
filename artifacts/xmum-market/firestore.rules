rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile, but only write their own
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Listings: anyone can read
    // Create: must be signed in with an @xmu.edu.my email
    //   (email_verified check is enforced in the UI layer; removing it here
    //    avoids the race condition where the ID token hasn't been refreshed
    //    yet after clicking the verification link)
    // Update/Delete: only the original poster
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.email.matches('.*@xmu\\.edu\\.my');
      allow update, delete: if request.auth != null
                             && request.auth.uid == resource.data.userId;
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if false;
    }

    // Conversations: only participants can read or write
    // Create: authenticated @xmu.edu.my user who includes themselves as a participant
    match /conversations/{convId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.token.email.matches('.*@xmu\\.edu\\.my')
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      // Messages subcollection: participants only
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
                      && request.auth.uid == request.resource.data.senderId;
      }
    }
  }
}
