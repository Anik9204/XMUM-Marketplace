rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isXmuEmail() {
      return isSignedIn() &&
        request.auth.token.email.matches('.*@xmu\\.edu\\.my');
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }
    function isEditor() {
      return isSignedIn() && (getUserRole() == 'editor' || getUserRole() == 'admin');
    }
    function isShopOwner(shopId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }
    function isShopMember(shopId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/shops/$(shopId)).data.editorIds
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isXmuEmail()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 1000
                    && request.resource.data.type in
                       ["buy-sell","lost-found","jobs","assistance","rental"];
      allow update, delete: if isOwner(resource.data.userId) || isEditor();
    }

    // ── Campus Market Shops ───────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isXmuEmail()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.editorIds.size() <= 3;
      allow update: if isShopOwner(shopId) || isAdmin();
      allow delete: if isShopOwner(shopId) || isAdmin();
    }

    // ── Shop Listings ─────────────────────────────────────────────────────────
    match /shopListings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isShopMember(request.resource.data.shopId);
      allow update: if isSignedIn() && isShopMember(resource.data.shopId);
      allow delete: if isSignedIn() && isShopMember(resource.data.shopId);
    }

    // ── Shop Inquiries ────────────────────────────────────────────────────────
    match /shopInquiries/{inquiryId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        isShopMember(resource.data.shopId)
      );
      allow create: if isXmuEmail()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 500;
      allow update: if isSignedIn() && (
        isShopMember(resource.data.shopId) ||
        resource.data.buyerId == request.auth.uid
      );
    }

    // ── Shop Reviews ──────────────────────────────────────────────────────────
    match /shopReviews/{reviewId} {
      allow read: if true;
      allow create: if isXmuEmail()
                    && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Shop Ads ──────────────────────────────────────────────────────────────
    match /shopAds/{adId} {
      allow read: if true;
      allow create: if isSignedIn() && isShopOwner(request.resource.data.shopId);
      allow update: if isAdmin() || isShopOwner(resource.data.shopId);
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isXmuEmail()
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 500;
      allow read, update: if isEditor();
      allow delete: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    match /analytics/{docId} {
      allow read: if isEditor();
      allow write: if isAdmin();
    }

    match /users/{userId}/notifications/{notifId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) || isEditor() || isXmuEmail();
    }

    match /rentalAuditLogs/{logId} {
      allow create: if isXmuEmail()
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /sellerTcAuditLogs/{logId} {
      allow create: if isXmuEmail()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    match /conversations/{convId} {
      allow read, write: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
    }

    match /conversations/{convId}/messages/{msgId} {
      allow read: if isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }
  }
}
